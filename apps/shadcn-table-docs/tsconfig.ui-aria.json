// The aria copy of the library, its example variants and its story copies,
// checked in a program of their own by `types:bases` (`types:check` and
// `build`): see tsconfig.build.json.
{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "components/ui-aria/**/*.ts",
    "components/ui-aria/**/*.tsx",
    "examples/.aria/**/*.ts",
    "examples/.aria/**/*.tsx",
    "stories/.aria/**/*.ts",
    "stories/.aria/**/*.tsx"
  ]
}
