{
  "name": "shadcn-table-docs",
  "version": "0.3.3",
  "private": true,
  "license": "MIT",
  "author": "Anindo Sarker",
  "repository": "github:anindosarker/shadcn-table",
  "homepage": "https://www.shadcn-table.com",
  "scripts": {
    "build": "pnpm -w registry:build && pnpm -w registry:items && pnpm -w registry:hosted && node lib/example-variants.mjs && next build",
    "predev": "node lib/example-variants.mjs",
    "dev": "next dev -p ${PORT:-5320}",
    "start": "next start -p 5320",
    "preview": "NEXT_DIST_DIR=.next-preview pnpm build && NEXT_DIST_DIR=.next-preview next start -p 5330",
    "types:check": "node lib/example-variants.mjs && next typegen && tsc --noEmit",
    "registry:hosted": "pnpm -w registry:hosted",
    "examples:variants": "node lib/example-variants.mjs",
    "lint": "eslint",
    "lib:install": "node scripts/install.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-query": "5.62.8",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.11.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "export-to-csv": "^1.5.0",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
    "highlight-words": "2.0.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.13",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.8.3"
  }
}
