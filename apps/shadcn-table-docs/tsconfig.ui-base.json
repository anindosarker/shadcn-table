// The base copy of the library, its example variants and its story copies,
// checked in a program of their own by `types:bases` (`types:check` and
// `build`): see tsconfig.build.json. The React Aria story copies are checked
// by tsconfig.ui-aria.json.
{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "components/ui-base/**/*.ts",
    "components/ui-base/**/*.tsx",
    "examples/.base/**/*.ts",
    "examples/.base/**/*.tsx",
    "stories/.base/**/*.ts",
    "stories/.base/**/*.tsx"
  ]
}
