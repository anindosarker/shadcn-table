{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**"
      ]
    },
    "dev": {
      "cache": false
    },
    "lint": {
      "outputs": []
    },
    "storybook:base": {
      "cache": false,
      "persistent": true
    },
    "storybook:radix": {
      "cache": false,
      "persistent": true
    },
    "storybook:aria": {
      "cache": false,
      "persistent": true
    },
    "storybook:build:base": {
      "outputs": [
        "storybook-static/base/**"
      ]
    },
    "storybook:build:radix": {
      "outputs": [
        "storybook-static/radix/**"
      ]
    },
    "storybook:build:aria": {
      "outputs": [
        "storybook-static/aria/**"
      ]
    },
    "test:base": {
      "cache": false
    },
    "test:radix": {
      "cache": false
    },
    "test:aria": {
      "cache": false
    }
  }
}
