{
  "name": "shadcn-table-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --parallel",
    "dev": "concurrently -n docs,storybook -c blue,green \"pnpm --filter shadcn-table-docs dev\" \"pnpm storybook\"",
    "dev:docs": "turbo run dev --parallel",
    "storybook": "concurrently -n base,radix,aria -c green,magenta,cyan \"pnpm --filter shadcn-table storybook:base\" \"pnpm --filter shadcn-table storybook:radix\" \"pnpm --filter shadcn-table storybook:aria\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,md}\"",
    "preview": "node tools/preview.mjs",
    "lint": "turbo run lint",
    "test": "node test/run.mjs",
    "registry:build": "pnpm --filter shadcn-table registry:build",
    "registry:items": "node tools/registry/examples.mjs",
    "registry:hosted": "node tools/registry/hosted.mjs",
    "add-part": "node tools/registry/add-part.mjs",
    "registry:dev": "pnpm --filter shadcn-table registry:dev && serve packages/shadcn-table/.dev -l 5310",
    "storybook:base": "turbo run storybook:base --filter=shadcn-table",
    "storybook:radix": "turbo run storybook:radix --filter=shadcn-table",
    "storybook:aria": "turbo run storybook:aria --filter=shadcn-table",
    "storybook:all": "pnpm --filter shadcn-table run --parallel \"/^storybook:(base|radix|aria)$/\"",
    "storybook:build": "turbo run storybook:build:base --filter=shadcn-table && turbo run storybook:build:radix --filter=shadcn-table && turbo run storybook:build:aria --filter=shadcn-table",
    "test:base": "turbo run test:base --filter=shadcn-table",
    "test:radix": "turbo run test:radix --filter=shadcn-table",
    "test:aria": "turbo run test:aria --filter=shadcn-table"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "pixelmatch": "8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "7.0.0",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "turbo": "2.5.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.0",
      "vite": "npm:rolldown-vite@7.1.12"
    }
  }
}
