{
  "name": "shadcn-table-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --parallel",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write \"**/*.{js,ts,tsx,md}\"",
    "preview": "node scripts/preview.mjs",
    "lint": "turbo run lint",
    "registry:build": "pnpm --filter shadcn-table registry:build",
    "registry:items": "node packages/shadcn-table/scripts/registry/examples.mjs",
    "registry:hosted": "node packages/shadcn-table/scripts/registry/hosted.mjs",
    "add-part": "node packages/shadcn-table/scripts/registry/add-part.mjs",
    "check:bases": "node packages/shadcn-table/scripts/registry/check-bases.mjs",
    "registry:dev": "pnpm --filter shadcn-table registry:dev && serve packages/shadcn-table/.dev -l 5310",
    "storybook:base": "turbo run storybook:base --filter=shadcn-table",
    "storybook:radix": "turbo run storybook:radix --filter=shadcn-table",
    "storybook:aria": "turbo run storybook:aria --filter=shadcn-table",
    "storybook:all": "pnpm --filter shadcn-table run --parallel \"/^storybook:(base|radix|aria)$/\"",
    "storybook:build": "pnpm --filter shadcn-table storybook:build:base && pnpm --filter shadcn-table storybook:build:radix && pnpm --filter shadcn-table storybook:build:aria",
    "test:base": "turbo run test:base --filter=shadcn-table",
    "test:radix": "turbo run test:radix --filter=shadcn-table",
    "test:aria": "turbo run test:aria --filter=shadcn-table"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.6.2",
    "serve": "^14.2.6",
    "turbo": "2.5.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.13",
      "vite": "npm:rolldown-vite@7.1.12"
    }
  }
}
