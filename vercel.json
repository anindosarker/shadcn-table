{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "docs": {
      "root": "apps/shadcn-table-docs",
      "framework": "nextjs"
    },
    "storybook": {
      "root": "packages/shadcn-table",
      "framework": "storybook",
      "buildCommand": "pnpm storybook:build:base && pnpm storybook:build:radix && pnpm storybook:build:aria",
      "outputDirectory": "storybook-static"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "pre": "storybook." } }],
      "destination": "/base/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "storybook." } }],
      "destination": { "service": "storybook" }
    },
    { "source": "/(.*)", "destination": { "service": "docs" } }
  ]
}
