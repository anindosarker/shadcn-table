{
  "extends": "./tsconfig.radix.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.baseui.tsbuildinfo",
    "paths": {
      "@/*": ["./registry/base/*"]
    }
  },
  "include": ["registry/base"],
  // Node-only item definition, read by scripts/registry/build.mjs.
  "exclude": ["registry/base/registry.ts"]
}
