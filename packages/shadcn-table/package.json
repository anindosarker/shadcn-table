{
  "name": "shadcn-table",
  "private": true,
  "license": "MIT",
  "author": "Anindo Sarker",
  "repository": "github:anindosarker/shadcn-table",
  "homepage": "https://shadcn-table.com",
  "version": "0.6.4",
  "type": "module",
  "scripts": {
    "preview": "node scripts/preview.mjs",
    "registry:build": "node scripts/registry/build.mjs && shadcn build",
    "registry:dev": "node scripts/registry/build.mjs --dev && shadcn build .dev/registry.json --output .dev/r",
    "storybook:base": "ST_BASE=base storybook dev -p 6007",
    "storybook:radix": "ST_BASE=radix storybook dev -p 6006",
    "storybook:aria": "ST_BASE=aria storybook dev -p 6008",
    "storybook:build:base": "ST_BASE=base storybook build -o storybook-static/base",
    "storybook:build:radix": "ST_BASE=radix storybook build -o storybook-static/radix",
    "storybook:build:aria": "ST_BASE=aria storybook build -o storybook-static/aria",
    "test:base": "ST_BASE=base vitest run",
    "test:radix": "ST_BASE=radix vitest run",
    "test:aria": "ST_BASE=aria vitest run",
    "lint": "eslint .",
    "tsc:radix": "tsc -p tsconfig.radix.json --noEmit",
    "tsc:baseui": "tsc -p tsconfig.baseui.json --noEmit",
    "tsc:aria": "tsc -p tsconfig.aria.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight-words": "2.0.0",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.8.1",
    "react-aria-components": "^1.22.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "^9.36.0",
    "@faker-js/faker": "^9.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/icons": "^2.2.0",
    "@storybook/react-vite": "^10.6.2",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.3",
    "@vitest/browser-playwright": "4.1.12",
    "concurrently": "^9.2.5",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "playwright": "^1.64.1",
    "shadcn": "^4.22.0",
    "storybook": "^10.6.2",
    "storybook-dark-mode": "^5.0.0",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "npm:rolldown-vite@7.1.12",
    "vitest": "4.1.12"
  }
}
